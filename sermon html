async function loadCommentary() {

  const commentary =
    document.getElementById(
      "commentarySelect"
    ).value;

  const book =
    document.getElementById(
      "commentaryBook"
    ).value.trim();

  const chapter =
    document.getElementById(
      "commentaryChapter"
    ).value.trim();

  const output =
    document.getElementById(
      "commentaryResults"
    );

  if (!book || !chapter) {

    output.innerHTML =
      "<p>Enter a Bible book and chapter.</p>";

    return;
  }

  if (commentary === "barnes") {

    output.innerHTML = `

      <div class="commentary-box">

        <strong>Barnes' Notes</strong>

        <p>
          Barnes' Notes is a New Testament commentary.
          The connection for this source is still being developed.
        </p>

      </div>

    `;

    return;
  }

  output.innerHTML =
    "<p>Loading commentary...</p>";

  try {

    const apiNames = {

      "matthew-henry":
        "matthew-henry",

      "john-gill":
        "john-gill",

      "jamieson-fausset-brown":
        "jamieson-fausset-brown",

      "adam-clarke":
        "adam-clarke",

      "matthew-henry-complete":
        "matthew-henry"

    };

    const apiName =
      apiNames[commentary];

    const url =
      "https://bible.helloao.org/api/c/" +
      apiName +
      "/" +
      encodeURIComponent(book) +
      "/" +
      encodeURIComponent(chapter) +
      ".json";

    const response =
      await fetch(url);

    if (!response.ok) {

      throw new Error(
        "Commentary request failed"
      );

    }

    const data =
      await response.json();

    let html = `
      <div class="commentary-box">
        <h3>${escapeHtml(commentaryName(commentary))}</h3>
      </div>
    `;

    const content =
      data.chapter &&
      data.chapter.content
        ? data.chapter.content
        : [];

    const verses =
      content.filter(function(item) {

        return item.type === "verse";

      });

    if (!verses.length) {

      output.innerHTML =
        "<p>Commentary loaded, but no verse commentary was found.</p>";

      return;
    }

    html += verses.map(function(item) {

      return `

        <div class="verse-card">

          <div class="verse-reference">

            ${escapeHtml(book)}
            ${escapeHtml(chapter)}:${escapeHtml(String(item.number))}

          </div>

          <div>
            ${escapeHtml(item.text || "")}
          </div>

        </div>

      `;

    }).join("");

    output.innerHTML = html;

  } catch (error) {

    console.error(error);

    output.innerHTML = `

      <div class="commentary-box">

        <strong>Unable to load this commentary right now.</strong>

        <p>
          The commentary source may be temporarily unavailable.
        </p>

      </div>

    `;

  }

}


function commentaryName(value) {

  const names = {

    "matthew-henry":
      "Matthew Henry Concise",

    "matthew-henry-complete":
      "Matthew Henry Complete",

    "john-gill":
      "John Gill",

    "jamieson-fausset-brown":
      "Jamieson-Fausset-Brown",

    "adam-clarke":
      "Adam Clarke",

    "barnes":
      "Barnes' Notes"

  };

  return names[value] || value;

}


/* =========================
   AI PLACEHOLDER
========================= */

function aiPlaceholder() {

  const question =
    document.getElementById(
      "aiQuestion"
    ).value.trim();

  const output =
    document.getElementById(
      "aiResult"
    );

  if (!question) {

    output.innerHTML =
      "<p>Enter a Bible study question first.</p>";

    return;
  }

  output.innerHTML = `

    <div class="commentary-box">

      <strong>Study Assistant</strong>

      <p>
        The AI study assistant can be connected here.
      </p>

      <p>
        For now, use the Bible, dictionary, concordance,
        Hebrew & Greek lookup, and commentary tools above
        to study your passage.
      </p>

    </div>

  `;

}


/* =========================
   SECURITY / TEXT
========================= */

function escapeHtml(value) {

  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}

