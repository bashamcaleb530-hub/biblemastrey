   * ----------------------------------------------------
   */

  function buildFinalSermon() {

    const title =
      value("sermonTitle") ||
      "Untitled Sermon";

    const topic =
      value("sermonTopic");

    const purpose =
      value("sermonPurpose");

    const mainScripture =
      value("mainScripture");

    const scriptureReason =
      value("scriptureReason");

    const observation =
      value("observation");

    const context =
      value("context");

    const mainTruth =
      value("mainTruth");

    const sermonStatement =
      value("sermonStatement");

    const introduction =
      value("introduction");

    const overallApplication =
      value("overallApplication");

    const encouragement =
      value("encouragement");

    const conclusion =
      value("conclusion");


    const points = [1, 2, 3]
      .map(number => ({

        title:
          value("point" + number + "Title"),

        scripture:
          value("point" + number + "Scripture"),

        explanation:
          value("point" + number + "Explanation"),

        application:
          value("point" + number + "Application")

      }))
      .filter(point =>
        point.title ||
        point.scripture ||
        point.explanation ||
        point.application
      );


    let html = `

      <article>

        <h2>
          ${escapeHTML(title)}
        </h2>

        ${topic ? `
          <h3>Topic</h3>
          <p>${formatText(topic)}</p>
        ` : ""}

        ${purpose ? `
          <h3>Purpose</h3>
          <p>${formatText(purpose)}</p>
        ` : ""}

        ${mainScripture ? `
          <h3>Main Scripture</h3>
          <p><strong>${escapeHTML(mainScripture)}</strong></p>
        ` : ""}

        ${scriptureReason ? `
          <h3>Why This Passage?</h3>
          <p>${formatText(scriptureReason)}</p>
        ` : ""}

        ${observation ? `
          <h3>Observations</h3>
          <p>${formatText(observation)}</p>
        ` : ""}

        ${context ? `
          <h3>Context</h3>
          <p>${formatText(context)}</p>
        ` : ""}

        ${mainTruth ? `
          <h3>Main Biblical Truth</h3>
          <p>${formatText(mainTruth)}</p>
        ` : ""}

        ${sermonStatement ? `
          <h3>Main Sermon Statement</h3>
          <p><strong>${formatText(sermonStatement)}</strong></p>
        ` : ""}

        ${introduction ? `
          <h3>Introduction</h3>
          <p>${formatText(introduction)}</p>
        ` : ""}

    `;


    points.forEach((point, index) => {

      html += `

        <section>

          <h3>
            Point ${index + 1}
            ${point.title
              ? ": " + escapeHTML(point.title)
              : ""}
          </h3>

          ${point.scripture ? `
            <p>
              <strong>Supporting Scripture:</strong>
              ${escapeHTML(point.scripture)}
            </p>
          ` : ""}

          ${point.explanation ? `
            <p>
              <strong>Explanation:</strong><br>
              ${formatText(point.explanation)}
            </p>
          ` : ""}

          ${point.application ? `
            <p>
              <strong>Application:</strong><br>
              ${formatText(point.application)}
            </p>
          ` : ""}

        </section>

      `;

    });


    if (overallApplication || encouragement) {

      html += `<h3>Application</h3>`;

      if (overallApplication) {
        html += `<p>${formatText(overallApplication)}</p>`;
      }

      if (encouragement) {
        html += `
          <p>
            <strong>Encouragement / Warning:</strong><br>
            ${formatText(encouragement)}
          </p>
        `;
      }

    }


    if (conclusion) {

      html += `

        <h3>Conclusion</h3>

        <p>
          ${formatText(conclusion)}
        </p>

      `;

    }


    html += `</article>`;


    document.getElementById(
      "finalSermon"
    ).innerHTML = html;

  }


  /*
   * ----------------------------------------------------
   * SAVE COMPLETE SERMON
   * ----------------------------------------------------
   */

  function saveSermon() {

    const fields = [

      "sermonTitle",
      "sermonTopic",
      "sermonPurpose",
      "mainScripture",
      "scriptureReason",
      "observation",
      "context",
      "mainTruth",
      "sermonStatement",

      "point1Title",
      "point1Scripture",
      "point1Explanation",
      "point1Application",

      "point2Title",
      "point2Scripture",
      "point2Explanation",
      "point2Application",

      "point3Title",
      "point3Scripture",
      "point3Explanation",
      "point3Application",

      "introduction",
      "overallApplication",
      "encouragement",
      "conclusion"

    ];


    const data = {};

    fields.forEach(id => {

      const element =
        document.getElementById(id);

      if (element) {
        data[id] =
          element.value;
      }

    });


    localStorage.setItem(
      "bibleMastreySavedSermon",
      JSON.stringify(data)
    );


    const status =
      document.getElementById("saveStatus");

    status.textContent =
      "Sermon saved on this device.";

    status.classList.add("show");

    setTimeout(
      () => status.classList.remove("show"),
      2500
    );

  }


  /*
   * ----------------------------------------------------
   * LOAD SAVED SERMON
   * ----------------------------------------------------
   */

  function loadSavedSermon() {

    const raw =
      localStorage.getItem(
        "bibleMastreySavedSermon"
      );

    if (!raw) {

      alert(
        "No saved sermon was found on this device."
      );

      return;
    }


    try {

      const data =
        JSON.parse(raw);


      Object.keys(data).forEach(id => {

        const element =
          document.getElementById(id);

        if (element) {
          element.value =
            data[id];
        }

      });


      alert("Saved sermon loaded.");

    } catch (error) {

      alert(
        "The saved sermon could not be loaded."
      );

    }

  }


  /*
   * ----------------------------------------------------
   * HELPERS
   * ----------------------------------------------------
   */

  function value(id) {

    const element =
      document.getElementById(id);

    return element
      ? element.value.trim()
      : "";

  }


  function showMessage(id, text) {

    const element =
      document.getElementById(id);

    if (!element) return;

    element.textContent =
      text;

    element.classList.add("show");

  }


  function formatText(text) {

    return escapeHTML(text)
      .replace(/\n/g, "<br>");
  }


  function escapeHTML(text) {

    return String(text || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }


  function escapeAttribute(text) {

    return String(text || "")
      .replace(/\\/g, "\\\\")
      .replace(/'/g, "\\'")
      .replace(/"/g, "&quot;");

  }


  /*
   * ----------------------------------------------------
   * LOAD SAVED BASICS ON START
   * ----------------------------------------------------
   */

  document.addEventListener(
    "DOMContentLoaded",
    function() {

      try {

        const raw =
          localStorage.getItem(
            "bibleMastreyCurrentSermonBasics"
          );

        if (!raw) return;

        const data =
          JSON.parse(raw);

        if (data.title) {
          document.getElementById(
            "sermonTitle"
          ).value = data.title;
        }

        if (data.topic) {
          document.getElementById(
            "sermonTopic"
          ).value = data.topic;
        }

        if (data.purpose) {
          document.getElementById(
            "sermonPurpose"
          ).value = data.purpose;
        }

      } catch (error) {

        console.log(
          "No previous sermon information loaded."
        );

      }

    }

  );


  /*
   * Translation changes reload the Bible
   */

  document.getElementById(
    "translation"
  ).addEventListener(
    "change",
    async function() {

      currentBible = null;

      await loadBible();

    }
  );

</script>

