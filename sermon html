    "<h3>Topic</h3>" +
    formatOutput(topic);

  sermon +=
    "<h3>Purpose</h3>" +
    formatOutput(purpose);

  sermon +=
    "<h3>Main Scripture</h3>" +
    formatOutput(scripture);

  sermon +=
