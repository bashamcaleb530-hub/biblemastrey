  const introduction =
    document.getElementById("introduction").value;

  const application =
    document.getElementById("application").value;

  const conclusion =
    document.getElementById("conclusion").value;


  const point1 =
    buildPoint(
      1,
      "point1Title",
      "point1Scripture",
      "point1Explanation",
      "point1Application"
    );

  const point2 =
    buildPoint(
      2,
      "point2Title",
      "point2Scripture",
