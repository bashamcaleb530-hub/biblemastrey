async function loadCommentary() {

  const selected =
    document.getElementById("commentarySelect")
      .value;

  const book =
    document.getElementById("commentaryBook")
      .value
      .trim();

  const chapter =
    document.getElementById("commentaryChapter")
      .value
      .trim();

  const verse =
    document.getElementById("commentaryVerse")
      .value
      .trim();

  const output =
    document.getElementById("commentaryResult");

  if (!book || !chapter) {

    output.innerHTML =
      "Enter a book and chapter.";

    return;

  }


  /* Barnes */

  if (selected === "barnes") {

    output.innerHTML =
      "<strong>Barnes' Notes</strong><br><br>" +
      "Barnes' Notes is a New Testament commentary. " +
      "The connection for this source is still being developed.";

    return;

  }


  /* Matthew Henry Complete */

  if (selected === "matthew-henry-complete") {

    await loadMatthewHenryComplete(
      book,
      chapter,
      verse,
      output
    );

    return;

  }


  const apiId =
    commentaryApiIds[selected];

  if (!apiId) {

    output.innerHTML =
      "This commentary is not currently connected.";

    return;

  }


  const bookId =
    convertBookForCommentary(book);

  const url =
    COMMENTARY_API +
    apiId +
    "/" +
    bookId +
    "/" +
    chapter +
    ".simple.json";


  output.innerHTML =
    "Loading commentary...";


  try {

    const response =
      await fetch(url);

    if (!response.ok) {

      throw new Error(
        "Commentary request failed"
      );

    }

    const data =
      await response.json();

    let html =
      "<h3>" +
      selected +
      "</h3>";


    if (
      data.chapter &&
      Array.isArray(data.chapter.content)
    ) {

      const verseItems =
        data.chapter.content.filter(function(item) {

          return item.type === "verse";

        });


      if (verse) {

        const selectedVerse =
          verseItems.find(function(item) {

            return String(item.number) ===
              String(verse);

          });

        if (selectedVerse) {

          html +=
            "<strong>Verse " +
            selectedVerse.number +
            "</strong><br><br>" +
            formatText(selectedVerse.text);

        } else {

          html +=
            "No commentary was found for verse " +
            verse +
            ".";

        }

      } else {

        verseItems.forEach(function(item) {

          html +=
            "<div style='margin-bottom:18px'>" +
            "<strong>Verse " +
            item.number +
            "</strong><br>" +
            formatText(item.text) +
            "</div>";

        });

      }

    } else {

      html +=
        "Commentary data was not available.";

    }

    output.innerHTML = html;

  } catch (error) {

    console.error(error);

    output.innerHTML =
      "This commentary could not be loaded right now.";

  }

}


/* =========================================
   MATTHEW HENRY COMPLETE
========================================= */

async function loadMatthewHenryComplete(
  book,
  chapter,
  verse,
  output
) {

  /*
    The complete Matthew Henry source is kept separate
    so this working integration can be carried over to
    Personal Bible Study.
  */

  const bookId =
    convertBookForCommentary(book);

  const possibleUrls = [

    "https://bible.helloao.org/api/c/matthew-henry/" +
      bookId +
      "/" +
      chapter +
      ".simple.json",

    "https://bible.helloao.org/api/c/matthew-henry/" +
      bookId +
      "/" +
      chapter +
      ".json"

  ];


  output.innerHTML =
    "Loading Matthew Henry Complete...";


  for (const url of possibleUrls) {

    try {

      const response =
        await fetch(url);

      if (!response.ok) {
        continue;
      }

      const data =
        await response.json();

      let html =
        "<h3>Matthew Henry Complete</h3>";

      if (
        data.chapter &&
        Array.isArray(data.chapter.content)
      ) {

        const items =
          data.chapter.content.filter(function(item) {

            return item.type === "verse";

          });


        if (verse) {

          const selected =
            items.find(function(item) {

              return String(item.number) ===
                String(verse);

            });

          if (selected) {

            html +=
              "<strong>Verse " +
              selected.number +
              "</strong><br><br>" +
              formatText(selected.text);

          } else {

            html +=
              "No commentary was found for verse " +
              verse +
              ".";

          }

        } else {

          items.forEach(function(item) {

            html +=
              "<div style='margin-bottom:18px'>" +
              "<strong>Verse " +
              item.number +
              "</strong><br>" +
              formatText(item.text) +
              "</div>";

          });

        }

      } else {

        html +=
          "Matthew Henry Complete data was not available.";

      }

      output.innerHTML = html;

      return;

    } catch (error) {

      console.log(
        "Matthew Henry source attempt failed:",
        error
      );

    }

  }


  output.innerHTML =
    "Matthew Henry Complete could not be loaded right now.";

}


