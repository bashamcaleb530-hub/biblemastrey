function formatText(text) {

  if (!text) return "";

  return String(text)
    .replace(/\n/g, "<br>");

}


function escapeQuotes(text) {

  return String(text)
    .replace(/\\/g, "\\\\")
    .replace(/'/g, "\\'")
    .replace(/"/g, "&quot;");

}


function copyText(text) {

  navigator.clipboard.writeText(text)
    .then(function() {

      alert("Copied.");

    });

}


