  async function loadCommentary() {

    const commentary =
      document.getElementById("commentarySelect")
        .value;

    const bookInput =
      document.getElementById("commentaryBook")
        .value
        .trim()
        .toLowerCase();

    const chapter =
      document.getElementById("commentaryChapter")
        .value
        .trim();

    const verse =
      document.getElementById("commentaryVerse")
        .value
        .trim();


    const status =
      document.getElementById("commentaryStatus");

    const side =
      document.getElementById("commentarySideContent");

    const area =
      document.getElementById("commentaryVerseArea");


    if (!bookInput || !chapter) {

      showMessage(
        "commentaryStatus",
        "Enter a book and chapter first."
      );

      return;
    }


    if (commentary === "barnes") {

      side.innerHTML = `
        <strong>Barnes' Notes</strong><br><br>
        Barnes' Notes is currently available as a study option,
        but its external source is not connected to this page yet.
        We will work on this connection later.
      `;

      area.innerHTML = "";

      showMessage(
        "commentaryStatus",
        "Barnes' Notes connection is still being developed."
      );

      return;
    }


    const book =
      bookMap[bookInput] ||
      bookInput;


    const commentaryId =
      commentaryIds[commentary];


    const url =
      `https://bible.helloao.org/api/c/${commentaryId}/${book}/${chapter}.simple.json`;


    side.innerHTML =
      "Loading commentary...";

    area.innerHTML =
      "Loading...";


    try {

      const response =
        await fetch(url);

      if (!response.ok) {
        throw new Error("Commentary request failed.");
      }

      const data =
        await response.json();


      const content =
        data?.chapter?.content || [];


      const entries =
        content.filter(
          item => item.type === "verse"
        );


      if (!entries.length) {

        area.innerHTML =
          "<div class='message show'>No commentary entries were found for this passage.</div>";

        side.innerHTML =
          "No commentary entries found.";

        return;
      }


      const selected =
        verse
          ? entries.filter(
              item =>
                String(item.number) === String(verse)
            )
          : entries;


      const usable =
        selected.length
          ? selected
          : entries;


      area.innerHTML =
        usable
          .map(item => `

            <div class="verse-card">

              <div class="verse-card-main">

                <div class="verse-reference">
                  ${escapeHTML(bookInput)}
                  ${chapter}:${escapeHTML(String(item.number))}
                </div>

                <div class="verse-text">
                  ${escapeHTML(item.text || "")}
                </div>

              </div>

            </div>

          `)
          .join("");


      side.innerHTML =
        usable
          .map(item => `

            <div class="commentary-entry">

              <div class="commentary-ref">
                ${escapeHTML(bookInput)}
                ${chapter}:${escapeHTML(String(item.number))}
              </div>

              <div>
                ${escapeHTML(item.text || "")}
              </div>

            </div>

          `)
          .join("");


      showMessage(
        "commentaryStatus",
        "Commentary loaded."
      );


    } catch (error) {

      console.error(error);

      area.innerHTML =
        "<div class='message show'>The commentary could not be loaded right now.</div>";

      side.innerHTML =
        "Commentary could not be loaded.";

      showMessage(
        "commentaryStatus",
        "The commentary source could not be reached."
      );

    }

  }


