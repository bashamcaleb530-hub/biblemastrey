  async function lookupDictionary() {

    const input =
      document.getElementById("dictionaryInput")
        .value
        .trim()
        .toLowerCase();

    const output =
      document.getElementById("dictionaryResult");

    if (!input) {

      output.classList.remove("hidden");

      output.innerHTML =
        "Enter a word to search.";

      return;
    }


    if (dictionaryDefinitions[input]) {

      output.classList.remove("hidden");

      output.innerHTML =
        `<strong>${escapeHTML(input)}</strong><br><br>
         ${escapeHTML(dictionaryDefinitions[input])}`;

      return;
    }


    try {

      const response =
        await fetch(
          "https://api.dictionaryapi.dev/api/v2/entries/en/" +
          encodeURIComponent(input)
        );

      if (!response.ok) {
        throw new Error("Dictionary request failed.");
      }

      const data =
        await response.json();

      const meanings =
        data[0]?.meanings || [];

      const definitions = [];

      meanings.forEach(meaning => {

        (meaning.definitions || [])
          .slice(0, 3)
          .forEach(def => {

            if (def.definition) {
              definitions.push(def.definition);
            }

          });

      });

      output.classList.remove("hidden");

      if (!definitions.length) {

        output.innerHTML =
          "No dictionary definition was found.";

      } else {

        output.innerHTML =
          `<strong>${escapeHTML(input)}</strong><br><br>` +
          definitions
            .map(def => "• " + escapeHTML(def))
            .join("<br><br>");
      }

    } catch (error) {

      output.classList.remove("hidden");

      output.innerHTML =
        "No definition could be loaded right now.";

    }

  }


