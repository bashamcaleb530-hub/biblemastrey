  async function lookupStrong() {

    let input =
      document.getElementById("strongInput")
        .value
        .trim()
        .toUpperCase();

    const output =
      document.getElementById("strongResult");

    if (!input) {

      output.classList.remove("hidden");

      output.innerHTML =
        "Enter a Strong's number such as G26 or H3068.";

      return;
    }


    if (/^[GH]\d+$/.test(input) === false) {

      output.classList.remove("hidden");

      output.innerHTML =
        "Please enter a Strong's number in the format G26 or H3068.";

      return;
    }


    const result =
      strongs[input];


    if (result) {

      output.classList.remove("hidden");

      output.innerHTML = `

        <strong>Strong's:</strong> ${input}<br><br>

        <strong>Language:</strong>
        ${escapeHTML(result.language)}<br><br>

        <strong>Original Word:</strong>
        ${escapeHTML(result.word)}<br><br>

        <strong>Transliteration:</strong>
        ${escapeHTML(result.transliteration)}<br><br>

        <strong>Meaning:</strong>
        ${escapeHTML(result.meaning)}

      `;

      return;
    }


    /*
     * Try Sefaria as a secondary lookup.
     */

    try {

      const response =
        await fetch(
          "https://www.sefaria.org/api/words/" +
          encodeURIComponent(input)
        );

      if (!response.ok) {
        throw new Error("No result");
      }

      const data =
        await response.json();

      if (
        data &&
        Object.keys(data).length
      ) {

        output.classList.remove("hidden");

        output.innerHTML =
          "<strong>Strong's:</strong> " +
          escapeHTML(input) +
          "<br><br>" +
          escapeHTML(
            JSON.stringify(data, null, 2)
          );

        return;
      }

    } catch (error) {

      console.log(
        "Secondary word lookup unavailable."
      );

    }


    output.classList.remove("hidden");

    output.innerHTML =
      `No result was found for <strong>${escapeHTML(input)}</strong> in the built-in lookup yet.`;
  }


