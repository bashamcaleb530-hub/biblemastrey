  function createVerseCard(item) {

    const id =
      "verse_" +
      Math.random()
        .toString(36)
        .substring(2, 10);

    const reference =
      `${item.book} ${item.chapter}:${item.verse}`;

    const escapedText =
      escapeHTML(item.text);

    return `
      <div class="verse-card">

        <div
          class="verse-card-main"
          onclick="toggleVerseToolbar('${id}')"
        >

          <div class="verse-reference">
            ${escapeHTML(reference)}
          </div>

          <div class="verse-text">
            ${escapedText}
          </div>

        </div>

        <div
          id="${id}_toolbar"
          class="verse-toolbar"
        >

          <button
            class="secondary"
            onclick="highlightVerse('${id}')"
          >
            Highlight
          </button>

          <button
            class="secondary"
            onclick="addVerseNote('${id}', '${escapeAttribute(reference)}')"
          >
            Notes
          </button>

          <button
            class="secondary"
            onclick="bookmarkVerse('${id}', '${escapeAttribute(reference)}')"
          >
            Bookmark
          </button>

          <button
            class="secondary"
            onclick="copyVerse('${escapeAttribute(reference)}', '${escapeAttribute(item.text)}')"
          >
            Copy
          </button>

          <button
            class="secondary"
            onclick="shareVerse('${escapeAttribute(reference)}', '${escapeAttribute(item.text)}')"
          >
            Share
          </button>

        </div>

        <div
          id="${id}_note"
          class="note-box"
        >

          <textarea
            id="${id}_note_text"
            placeholder="Write your note about this verse..."
          ></textarea>

          <button
            class="success"
            onclick="saveVerseNote('${id}', '${escapeAttribute(reference)}')"
          >
            Save Note
          </button>

        </div>

      </div>
    `;
  }


  function toggleVerseToolbar(id) {

    const toolbar =
      document.getElementById(id + "_toolbar");

    if (toolbar) {
      toolbar.classList.toggle("show");
    }
  }


  function highlightVerse(id) {

    const card =
      document.getElementById(id + "_toolbar")
        .parentElement;

    const main =
      card.querySelector(".verse-card-main");

    main.style.background =
      main.style.background === "rgb(254, 249, 195)"
        ? ""
        : "#fef9c3";
  }


  function addVerseNote(id, reference) {

    const note =
      document.getElementById(id + "_note");

    if (note) {
      note.classList.toggle("show");
    }
  }


  function saveVerseNote(id, reference) {

    const textarea =
      document.getElementById(id + "_note_text");

    const notes =
      JSON.parse(
        localStorage.getItem("bibleMastreySermonVerseNotes") ||
        "{}"
      );

    notes[reference] =
      textarea.value;

    localStorage.setItem(
      "bibleMastreySermonVerseNotes",
      JSON.stringify(notes)
    );

    alert("Verse note saved.");
  }


  function bookmarkVerse(id, reference) {

    const bookmarks =
      JSON.parse(
        localStorage.getItem("bibleMastreySermonBookmarks") ||
        "[]"
      );

    if (!bookmarks.includes(reference)) {
      bookmarks.push(reference);
    }

    localStorage.setItem(
      "bibleMastreySermonBookmarks",
      JSON.stringify(bookmarks)
    );

    alert("Verse bookmarked.");
  }


  function copyVerse(reference, text) {

    navigator.clipboard.writeText(
      reference + "\n" + text
    )
    .then(() => alert("Verse copied."))
    .catch(() => alert("Copy failed."));
  }


  function shareVerse(reference, text) {

    const shareText =
      reference + "\n" + text;

    if (navigator.share) {

      navigator.share({
        title: reference,
        text: shareText
      });

    } else {

      navigator.clipboard.writeText(shareText);

      alert("Verse copied for sharing.");
    }
  }


