<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Write a Sermon - BibleMastrey</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fa;
      color: #222;
    }

    header {
      background: #1f2937;
      color: white;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }

    header h1 {
      margin: 0;
      font-size: 24px;
    }

    header p {
      margin: 5px 0 0;
      color: #d1d5db;
      font-size: 14px;
    }

    .back-btn {
      color: white;
      text-decoration: none;
      background: #374151;
      padding: 10px 15px;
      border-radius: 8px;
      font-size: 14px;
    }

    .back-btn:hover {
      background: #4b5563;
    }

    .page {
      max-width: 1200px;
      margin: auto;
      padding: 20px;
    }

    .hero {
      background: white;
      border-radius: 14px;
      padding: 25px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    .hero h2 {
      margin-top: 0;
      color: #1f2937;
    }

    .hero p {
      line-height: 1.6;
      color: #4b5563;
    }

    .course-intro {
      background: #eef6ff;
      border-left: 5px solid #2563eb;
      padding: 15px;
      border-radius: 8px;
      margin-top: 15px;
      line-height: 1.6;
    }

    .step {
      background: white;
      border-radius: 14px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,.07);
      overflow: hidden;
    }

    .step-header {
      background: #f8fafc;
      padding: 18px 20px;
      border-bottom: 1px solid #e5e7eb;
    }

    .step-number {
      display: inline-block;
      background: #2563eb;
      color: white;
      border-radius: 50%;
      width: 34px;
      height: 34px;
      text-align: center;
      line-height: 34px;
      font-weight: bold;
      margin-right: 8px;
    }

    .step-header h3 {
      display: inline;
      font-size: 20px;
      color: #1f2937;
    }

    .step-body {
      padding: 20px;
    }

    .lesson {
      background: #f9fafb;
      border-radius: 8px;
      padding: 14px;
      margin-bottom: 18px;
      line-height: 1.6;
    }

    .lesson strong {
      color: #1f2937;
    }

    label {
      display: block;
      font-weight: bold;
      margin: 12px 0 6px;
    }

    input,
    textarea,
    select {
      width: 100%;
      padding: 11px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-family: inherit;
      font-size: 15px;
      background: white;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
      line-height: 1.5;
    }

    .small-textarea {
      min-height: 80px;
    }

    button {
      border: none;
      border-radius: 8px;
      padding: 11px 16px;
      cursor: pointer;
      font-size: 14px;
      font-weight: bold;
      margin-top: 10px;
    }

    .primary {
      background: #2563eb;
      color: white;
    }

    .primary:hover {
      background: #1d4ed8;
    }

    .secondary {
      background: #e5e7eb;
      color: #1f2937;
    }

    .success {
      background: #15803d;
      color: white;
    }

    .danger {
      background: #b91c1c;
      color: white;
    }

    .tool-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .tool-row button {
      margin-top: 0;
    }

    .hidden {
      display: none;
    }

    .message {
      margin-top: 12px;
      padding: 10px;
      border-radius: 8px;
      background: #f3f4f6;
      color: #374151;
      display: none;
    }

    .message.show {
      display: block;
    }

    .verse-results {
      margin-top: 15px;
    }

    .verse-card {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      margin-bottom: 12px;
      overflow: hidden;
      background: white;
    }

    .verse-card-main {
      padding: 14px;
      cursor: pointer;
    }

    .verse-card-main:hover {
      background: #f9fafb;
    }

    .verse-reference {
      font-weight: bold;
      color: #2563eb;
      margin-bottom: 7px;
    }

    .verse-text {
      line-height: 1.6;
    }

    .verse-toolbar {
      display: none;
      padding: 10px;
      border-top: 1px solid #e5e7eb;
      background: #f9fafb;
      gap: 7px;
      flex-wrap: wrap;
    }

    .verse-toolbar.show {
      display: flex;
    }

    .verse-toolbar button {
      margin: 0;
      padding: 7px 10px;
      font-size: 12px;
    }

    .note-box {
      display: none;
      padding: 12px;
      border-top: 1px solid #e5e7eb;
      background: #fff;
    }

    .note-box.show {
      display: block;
    }

    .note-box textarea {
      min-height: 75px;
    }

    .study-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .point-box {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 15px;
      margin-bottom: 12px;
    }

    .point-box h4 {
      margin-top: 0;
    }

    .dictionary-result,
    .word-result,
    .commentary-result {
      margin-top: 15px;
      padding: 15px;
      border-radius: 10px;
      background: #f9fafb;
      line-height: 1.6;
    }

    .commentary-layout {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 15px;
      margin-top: 15px;
    }

    .commentary-verses {
      min-width: 0;
    }

    .commentary-side {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 15px;
      position: sticky;
      top: 15px;
      max-height: 600px;
      overflow-y: auto;
    }

    .commentary-side h4 {
      margin-top: 0;
    }

    .commentary-entry {
      border-bottom: 1px solid #ddd;
      padding: 12px 0;
      line-height: 1.55;
    }

    .commentary-entry:last-child {
      border-bottom: none;
    }

    .commentary-ref {
      font-weight: bold;
      color: #2563eb;
      margin-bottom: 5px;
    }

    .outline-box {
      border: 2px dashed #d1d5db;
      border-radius: 10px;
      padding: 15px;
      margin-top: 12px;
    }

    .final-sermon {
      background: #fff;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      padding: 25px;
      line-height: 1.7;
    }

    .final-sermon h2,
    .final-sermon h3 {
      color: #1f2937;
    }

    .status {
      padding: 10px;
      background: #ecfdf5;
      color: #166534;
      border-radius: 8px;
      margin-top: 10px;
      display: none;
    }

    .status.show {
      display: block;
    }

    .ai-box {
      background: #f5f3ff;
      border-left: 5px solid #7c3aed;
      padding: 15px;
      border-radius: 8px;
      line-height: 1.6;
    }

    footer {
      text-align: center;
      color: #6b7280;
      padding: 30px 20px;
      font-size: 13px;
    }

    @media (max-width: 850px) {
      .study-grid,
      .commentary-layout {
        grid-template-columns: 1fr;
      }

      .commentary-side {
        position: static;
        max-height: none;
      }
    }

    @media print {
      header,
      .hero,
      .step-header,
      .lesson,
      .tool-row,
      button,
      .back-btn,
      footer {
        display: none !important;
      }

      body {
        background: white;
      }

      .page {
        max-width: none;
        padding: 0;
      }

      .step {
        box-shadow: none;
        margin-bottom: 0;
      }

      .step:not(#finalStep) {
        display: none;
      }

      #finalStep {
        display: block !important;
      }

      .final-sermon {
        border: none;
      }
    }
  </style>
</head>

<body>

<header>
  <div>
    <h1>🎤 Write a Sermon</h1>
    <p>BibleMastrey Sermon Preparation & Study Helper</p>
  </div>

  <a href="index.html" class="back-btn">← Back to BibleMastrey</a>
</header>

<div class="page">

  <section class="hero">

    <h2>Learn How to Prepare and Write a Biblical Sermon</h2>

    <p>
      This is more than a sermon generator. It is designed to help you
      study Scripture, understand what you are studying, develop biblical
      points, and learn how to organize those discoveries into a sermon.
    </p>

    <div class="course-intro">
      <strong>The goal:</strong>
      You do the studying. BibleMastrey helps you organize, research,
      understand, and prepare.
      AI can eventually assist you, but it should never replace your own
      study of God's Word.
    </div>

  </section>


  <!-- STEP 1 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">1</span>
      <h3>Choose Your Sermon Topic</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        <strong>What you are learning:</strong><br>
        A sermon normally begins with a biblical burden, question, passage,
        or subject. Start by clearly identifying what you want people to
        understand from Scripture.
      </div>

      <label for="sermonTitle">Sermon Title</label>
      <input
        id="sermonTitle"
        placeholder="Example: Learning to Forgive"
      >

      <label for="sermonTopic">What is the sermon about?</label>
      <textarea
        id="sermonTopic"
        class="small-textarea"
        placeholder="Describe the topic in your own words..."
      ></textarea>

      <label for="sermonPurpose">What do you want people to learn or understand?</label>
      <textarea
        id="sermonPurpose"
        placeholder="Example: I want people to understand what biblical forgiveness really means."
      ></textarea>

      <button class="primary" onclick="saveSermonBasics()">
        Save Sermon Topic
      </button>

      <div id="topicStatus" class="status">
        Sermon topic saved.
      </div>

    </div>

  </section>


  <!-- STEP 2 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">2</span>
      <h3>Find Your Main Scripture</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        <strong>What you are learning:</strong><br>
        A sermon should be rooted in Scripture. Look for a passage that
        directly teaches the biblical truth you want to explain.
      </div>

      <div class="study-grid">

        <div>
          <label>Translation</label>
          <select id="translation">
            <option value="KJV">KJV</option>
            <option value="WEB">WEB</option>
            <option value="ASV">ASV</option>
          </select>
        </div>

        <div>
          <label>Search the Bible</label>
          <input
            id="bibleSearch"
            placeholder="Example: forgive"
            onkeydown="if(event.key==='Enter') searchBible()"
          >
        </div>

      </div>

      <button class="primary" onclick="searchBible()">
        🔎 Search Scripture
      </button>

      <div id="bibleSearchStatus" class="message"></div>

      <div id="bibleResults" class="verse-results"></div>

      <label>Main Scripture Reference</label>
      <input
        id="mainScripture"
        placeholder="Example: Ephesians 4:32"
      >

      <label>Why did you choose this passage?</label>
      <textarea
        id="scriptureReason"
        placeholder="Write your own observations..."
      ></textarea>

    </div>

  </section>


  <!-- STEP 3 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">3</span>
      <h3>Study the Passage</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        <strong>Before writing your sermon, slow down.</strong><br><br>

        Ask:
        <br>• Who wrote this?
        <br>• Who was it written to?
        <br>• What is happening?
        <br>• What comes before and after the passage?
        <br>• What is the main idea?
        <br>• What does the passage actually say?
        <br>• What does it mean?
        <br>• How should it affect our lives?
      </div>

      <label>What does the passage say?</label>
      <textarea
        id="observation"
        placeholder="Write what you observe in the actual text..."
      ></textarea>

      <label>What is the context?</label>
      <textarea
        id="context"
        placeholder="Write what you learn about the surrounding passage, chapter, book, author, audience, etc."
      ></textarea>

      <label>What is the main biblical truth?</label>
      <textarea
        id="mainTruth"
        placeholder="Write the main truth you believe this passage teaches."
      ></textarea>

    </div>

  </section>


  <!-- STEP 4 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">4</span>
      <h3>Study Important Words</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        <strong>What you are learning:</strong><br>
        Sometimes one important word can help you understand a passage more
        clearly. Use the tools below as study aids. Always consider the word
        in its biblical context.
      </div>

      <label>Dictionary Search</label>

      <div class="tool-row">
        <input id="dictionaryInput" placeholder="Example: forgiveness">
        <button class="primary" onclick="lookupDictionary()">
          Search Dictionary
        </button>
      </div>

      <div id="dictionaryResult" class="dictionary-result hidden"></div>

      <label>Concordance Search</label>

      <div class="tool-row">
        <input id="concordanceInput" placeholder="Search a word in Scripture">
        <button class="primary" onclick="searchConcordance()">
          Search Concordance
        </button>
      </div>

      <div id="concordanceResult" class="verse-results"></div>

      <label>Hebrew & Greek / Strong's Lookup</label>

      <div class="tool-row">
        <input id="strongInput" placeholder="Example: G26 or H3068">
        <button class="primary" onclick="lookupStrong()">
          Look Up Word
        </button>
      </div>

      <div id="strongResult" class="word-result hidden"></div>

    </div>

  </section>


  <!-- STEP 5 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">5</span>
      <h3>Study Bible Commentaries</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        <strong>What you are learning:</strong><br>
        Commentaries can give historical and theological observations that
        may help you think more deeply about a passage. They are study aids,
        not replacements for Scripture.
      </div>

      <div class="study-grid">

        <div>
          <label>Commentary</label>

          <select id="commentarySelect">
            <option value="matthew-henry-concise">
              Matthew Henry Concise
            </option>

            <option value="matthew-henry-complete">
              Matthew Henry Complete
            </option>

            <option value="john-gill">
              John Gill
            </option>

            <option value="jfb">
              Jamieson-Fausset-Brown
            </option>

            <option value="adam-clarke">
              Adam Clarke
            </option>

            <option value="barnes">
              Barnes' Notes
            </option>
          </select>
        </div>

        <div>
          <label>Book</label>

          <input
            id="commentaryBook"
            placeholder="Example: John"
          >
        </div>

      </div>

      <div class="study-grid">

        <div>
          <label>Chapter</label>
          <input
            id="commentaryChapter"
            type="number"
            min="1"
            placeholder="Example: 3"
          >
        </div>

        <div>
          <label>Verse (optional)</label>
          <input
            id="commentaryVerse"
            type="number"
            min="1"
            placeholder="Example: 16"
          >
        </div>

      </div>

      <button class="primary" onclick="loadCommentary()">
        📖 Load Commentary
      </button>

      <div id="commentaryStatus" class="message"></div>

      <div class="commentary-layout">

        <div class="commentary-verses">
          <div id="commentaryVerseArea"></div>
        </div>

        <aside class="commentary-side">
          <h4>Commentary</h4>
          <div id="commentarySideContent">
            Select a book and chapter to study commentary.
          </div>
        </aside>

      </div>

    </div>

  </section>


  <!-- STEP 6 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">6</span>
      <h3>Develop Your Sermon Point</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        <strong>What you are learning:</strong><br>
        A sermon should have a clear central message. Your points should
        support that message rather than becoming unrelated ideas.
      </div>

      <label>Main Sermon Statement</label>

      <textarea
        id="sermonStatement"
        placeholder="In one clear sentence, what are you trying to teach?"
      ></textarea>

      <div class="point-box">

        <h4>Point 1</h4>

        <label>Point title</label>
        <input id="point1Title" placeholder="Example: Forgiveness reflects God's character">

        <label>Supporting Scripture</label>
        <input id="point1Scripture" placeholder="Example: Ephesians 4:32">

        <label>Explanation</label>
        <textarea id="point1Explanation"></textarea>

        <label>Application</label>
        <textarea id="point1Application"></textarea>

      </div>


      <div class="point-box">

        <h4>Point 2</h4>

        <label>Point title</label>
        <input id="point2Title">

        <label>Supporting Scripture</label>
        <input id="point2Scripture">

        <label>Explanation</label>
        <textarea id="point2Explanation"></textarea>

        <label>Application</label>
        <textarea id="point2Application"></textarea>

      </div>


      <div class="point-box">

        <h4>Point 3</h4>

        <label>Point title</label>
        <input id="point3Title">

        <label>Supporting Scripture</label>
        <input id="point3Scripture">

        <label>Explanation</label>
        <textarea id="point3Explanation"></textarea>

        <label>Application</label>
        <textarea id="point3Application"></textarea>

      </div>

    </div>

  </section>


  <!-- STEP 7 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">7</span>
      <h3>Write the Introduction</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        <strong>What you are learning:</strong><br>
        A good introduction helps people understand why the subject matters
        and prepares them to listen to the biblical truth that follows.
      </div>

      <label>Introduction</label>

      <textarea
        id="introduction"
        style="min-height:180px"
        placeholder="How will you introduce the subject and lead people into the Scripture?"
      ></textarea>

    </div>

  </section>


  <!-- STEP 8 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">8</span>
      <h3>Application</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        <strong>What you are learning:</strong><br>
        Biblical preaching should help people understand how God's Word
        applies to their lives. Application should come from the truth of
        Scripture rather than simply personal opinion.
      </div>

      <label>What should the listener do with this truth?</label>

      <textarea
        id="overallApplication"
        style="min-height:180px"
        placeholder="What should change, what should they believe, or what should they do?"
      ></textarea>

      <label>What warning or encouragement should they remember?</label>

      <textarea
        id="encouragement"
        class="small-textarea"
      ></textarea>

    </div>

  </section>


  <!-- STEP 9 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">9</span>
      <h3>Write the Conclusion</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        <strong>What you are learning:</strong><br>
        The conclusion should bring the sermon back to its central truth
        and leave the listener with a clear biblical response.
      </div>

      <label>Conclusion</label>

      <textarea
        id="conclusion"
        style="min-height:180px"
        placeholder="Bring the sermon back to the main truth and call the listener to respond."
      ></textarea>

    </div>

  </section>


  <!-- STEP 10 -->

  <section class="step">

    <div class="step-header">
      <span class="step-number">10</span>
      <h3>AI Study Assistant</h3>
    </div>

    <div class="step-body">

      <div class="ai-box">

        <strong>🤖 AI Assistant — Coming in a future update</strong>

        <p>
          The AI assistant will be designed to help you study and prepare,
          not simply write the sermon for you.
        </p>

        <p>
          It will be able to help you ask questions such as:
        </p>

        <ul>
          <li>What other Scriptures relate to this subject?</li>
          <li>What should I investigate about this passage?</li>
          <li>What questions should I ask about the context?</li>
          <li>Are my sermon points supported by Scripture?</li>
          <li>Can you help me understand this difficult passage?</li>
        </ul>

        <p>
          The goal is to keep Scripture at the center.
        </p>

      </div>

    </div>

  </section>


  <!-- FINAL SERMON -->

  <section class="step" id="finalStep">

    <div class="step-header">
      <span class="step-number">✓</span>
      <h3>Your Sermon</h3>
    </div>

    <div class="step-body">

      <div class="lesson">
        Review your study before considering the sermon finished.
        Make sure your main points actually come from the biblical text.
      </div>

      <div class="tool-row">
        <button class="success" onclick="buildFinalSermon()">
          📝 Build Sermon
        </button>

        <button class="secondary" onclick="saveSermon()">
          💾 Save Sermon
        </button>

        <button class="secondary" onclick="loadSavedSermon()">
          📂 Load Saved Sermon
        </button>

        <button class="secondary" onclick="window.print()">
          🖨️ Print Sermon
        </button>
      </div>

      <div id="saveStatus" class="status"></div>

      <div id="finalSermon" class="final-sermon">
        Your finished sermon will appear here after you click
        <strong>Build Sermon</strong>.
      </div>

    </div>

  </section>

</div>


<footer>
  BibleMastrey — Study God's Word. Learn. Prepare. Teach.
</footer>


<script src="bible.js"></script>

<script>

  let currentBible = null;
  let currentTranslation = "KJV";


  /*
   * ----------------------------------------------------
   * BIBLE LOADING
   * ----------------------------------------------------
   */

  async function loadBible() {

    try {

      currentTranslation =
        document.getElementById("translation").value;

      if (currentTranslation === "WEB") {
        currentBible = await getWEB();
      }

      else if (currentTranslation === "ASV") {
        currentBible = await getASV();
      }

      else {
        currentBible = await getKJV();
      }

      return currentBible;

    } catch (error) {

      console.error(error);

      showMessage(
        "bibleSearchStatus",
        "The Bible could not be loaded right now."
      );

      return null;
    }
  }


  /*
   * ----------------------------------------------------
   * NORMALIZE BIBLE DATA
   * ----------------------------------------------------
   */

  function getBooks(bible) {

    if (!bible) return [];

    if (Array.isArray(bible.books)) {
      return bible.books;
    }

    return [];
  }


  function getBookName(book) {

    return (
      book.book ||
      book.name ||
      book.title ||
      book.englishName ||
      "Unknown"
    );
  }


  function getChapters(book) {

    return Array.isArray(book.chapters)
      ? book.chapters
      : [];
  }


  function getChapterNumber(chapter, index) {

    return (
      chapter.chapter ||
      chapter.number ||
      (index + 1)
    );
  }


  function getVerses(chapter) {

    return Array.isArray(chapter.verses)
      ? chapter.verses
      : [];
  }


  function getVerseNumber(verse, index) {

    return (
      verse.number ||
      verse.verse ||
      (index + 1)
    );
  }


  function getVerseText(verse) {

    return (
      verse.text ||
      verse.content ||
      ""
    );
  }


