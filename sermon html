function buildPoint(
  number,
  titleId,
  scriptureId,
  explanationId,
  applicationId
) {

  const title =
    document.getElementById(titleId).value;

  const scripture =
    document.getElementById(scriptureId).value;

  const explanation =
    document.getElementById(explanationId).value;

  const application =
    document.getElementById(applicationId).value;

  return `
    <h2>Point ${number}: ${escapeHtml(title)}</h2>

    <p>
      <strong>Supporting Scripture:</strong><br>
      ${formatOutput(scripture)}
    </p>

    <p>
      <strong>Explanation:</strong><br>
      ${formatOutput(explanation)}
    </p>

    <p>
      <strong>Application:</strong><br>
      ${formatOutput(application)}
    </p>
  `;

}


function formatOutput(text) {

  return escapeHtml(text || "")
    .replace(/\n/g, "<br>");

}


function escapeHtml(text) {

  return String(text)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}


/* =========================================
   SAVE SERMON
========================================= */

function saveSermon() {

  const fields = [

    "sermonTitle",
    "sermonTopic",
    "sermonPurpose",
    "mainScripture",
    "scriptureReason",
    "observation",
    "context",
    "biblicalTruth",
    "dictionaryWord",
    "concordanceWord",
    "strongsInput",
    "commentaryBook",
    "commentaryChapter",
    "commentaryVerse",
    "mainPoint",
    "point1Title",
    "point1Scripture",
    "point1Explanation",
    "point1Application",
    "point2Title",
    "point2Scripture",
    "point2Explanation",
    "point2Application",
    "point3Title",
    "point3Scripture",
    "point3Explanation",
    "point3Application",
    "introduction",
    "application",
    "conclusion"

  ];

  const data = {};

  fields.forEach(function(id) {

    const element =
      document.getElementById(id);

    if (element) {
      data[id] = element.value;
    }

  });


  localStorage.setItem(
    "bibleMastreySermon",
    JSON.stringify(data)
  );


  alert("Sermon saved.");

}


/* =========================================
   LOAD SERMON
========================================= */

function loadSermon() {

  const saved =
    localStorage.getItem(
      "bibleMastreySermon"
    );

  if (!saved) {

    alert("No saved sermon found.");

    return;

  }


  const data =
    JSON.parse(saved);


  Object.keys(data).forEach(function(id) {

    const element =
      document.getElementById(id);

    if (element) {

      element.value =
        data[id];

    }

  });


  alert("Saved sermon loaded.");

}

</script>

