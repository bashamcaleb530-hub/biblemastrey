  async function searchBible() {

    const query =
      document.getElementById("bibleSearch")
        .value
        .trim()
        .toLowerCase();

    if (!query) {
      showMessage(
        "bibleSearchStatus",
        "Enter a word or phrase to search."
      );
      return;
    }

    const bible = await loadBible();

    if (!bible) return;

    const results = [];

    getBooks(bible).forEach(book => {

      const bookName = getBookName(book);

      getChapters(book).forEach((chapter, chapterIndex) => {

        const chapterNumber =
          getChapterNumber(chapter, chapterIndex);

        getVerses(chapter).forEach((verse, verseIndex) => {

          const text = getVerseText(verse);

          if (
            text &&
            text.toLowerCase().includes(query)
          ) {

            results.push({
              book: bookName,
              chapter: chapterNumber,
              verse: getVerseNumber(verse, verseIndex),
              text: text
            });

          }

        });

      });

    });


    const limited = results.slice(0, 30);

    const container =
      document.getElementById("bibleResults");

    if (!limited.length) {

      container.innerHTML =
        "<div class='message show'>No matching verses were found.</div>";

      return;
    }


    container.innerHTML = limited
      .map(item => createVerseCard(item))
      .join("");

  }


