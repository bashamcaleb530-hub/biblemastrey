async function searchBible() {

  const query =
    document.getElementById("bibleSearch").value
      .trim()
      .toLowerCase();

  const output =
    document.getElementById("bibleResults");

  if (!query) {
    output.innerHTML = "Enter a search term.";
    return;
  }

  output.innerHTML = "Searching...";

  try {

    const bible = await getSelectedBible();

    const results = [];

    bible.books.forEach(function(book) {

      book.chapters.forEach(function(chapter) {

        chapter.verses.forEach(function(verse) {

          if (
            verse.text &&
            verse.text.toLowerCase().includes(query)
          ) {

            results.push({
              book: book.book || book.name || book.title,
              chapter: chapter.chapter,
              verse: verse.number,
              text: verse.text
            });

          }

        });

      });

    });

    if (!results.length) {
      output.innerHTML = "No results found.";
      return;
    }

    output.innerHTML = "";

    results.slice(0, 50).forEach(function(result) {

      const div = document.createElement("div");

      div.className = "verse-card";

      div.innerHTML = `
        <div class="verse-reference">
          ${result.book} ${result.chapter}:${result.verse}
        </div>

        <div>${result.text}</div>

        <div class="verse-actions">

          <button onclick="copyText('${escapeQuotes(
            result.text
          )}')">
            Copy
          </button>

          <button onclick="useMainScripture(
            '${escapeQuotes(
              result.book + " " +
              result.chapter + ":" +
              result.verse
            )}'
          )">
            Use as Main Scripture
          </button>

        </div>
      `;

      output.appendChild(div);

    });

  } catch (error) {

    console.error(error);

    output.innerHTML =
      "The Bible could not be loaded right now.";

  }

}


