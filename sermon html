async function dictionarySearch() {

  const word =
    document.getElementById("dictionaryWord")
      .value
      .trim();

  const output =
    document.getElementById("dictionaryResult");

  if (!word) {
    output.innerHTML = "Enter a word.";
    return;
  }

  output.innerHTML = "Searching dictionary...";

  try {

    const response =
      await fetch(
        "https://api.dictionaryapi.dev/api/v2/entries/en/" +
        encodeURIComponent(word)
      );

    if (!response.ok) {
      throw new Error("Dictionary unavailable");
    }

    const data = await response.json();

    let html =
      "<strong>" +
      word +
      "</strong><br><br>";

    data.forEach(function(entry) {

      if (!entry.meanings) return;

      entry.meanings.forEach(function(meaning) {

        html +=
          "<strong>" +
          (meaning.partOfSpeech || "") +
          "</strong><br>";

        if (meaning.definitions) {

          meaning.definitions
            .slice(0, 5)
            .forEach(function(definition) {

              html +=
                "• " +
                definition.definition +
                "<br>";

            });

        }

        html += "<br>";

      });

    });

    output.innerHTML = html;

  } catch (error) {

    output.innerHTML =
      "Dictionary results could not be loaded.";

  }

}


