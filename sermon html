async function searchConcordance() {

  const word =
    document.getElementById(
      "concordanceSearch"
    ).value.trim().toLowerCase();

  const output =
    document.getElementById(
      "concordanceResults"
    );

  if (!word) {

    output.innerHTML =
      "<p>Please enter a word.</p>";

    return;
  }

  output.innerHTML =
    "<p>Searching KJV...</p>";

  try {

    const bible =
      await getKJV();

    const matches = [];

    if (
      bible &&
      Array.isArray(bible.books)
    ) {

      bible.books.forEach(function(book) {

        (book.chapters || [])
          .forEach(function(chapter) {

            (chapter.verses || [])
              .forEach(function(verse) {

                const text =
                  (
                    verse.text ||
                    ""
                  ).toLowerCase();

                if (
                  text.includes(word)
                ) {

                  matches.push({

                    reference:
                      book.book +
                      " " +
                      (
                        chapter.chapter ||
                        chapter.number
                      ) +
                      ":" +
                      verse.number,

                    text:
                      verse.text

                  });

                }

              });

          });

      });

    }

    if (!matches.length) {

      output.innerHTML =
        "<p>No results found.</p>";

      return;
    }

    output.innerHTML =
      matches
        .slice(0, 25)
        .map(function(item) {

          return `
            <div class="verse-card">

              <div class="verse-reference">
                ${escapeHtml(item.reference)}
              </div>

              <div>
                ${escapeHtml(item.text)}
              </div>

            </div>
          `;

        }).join("");

  } catch (error) {

    console.error(error);

    output.innerHTML =
      "<p>Unable to search the concordance.</p>";

  }

}


