async function searchBible() {

  const query =
    document.getElementById("bibleSearch").value.trim();

  const output =
    document.getElementById("bibleResults");

  if (!query) {

    output.innerHTML =
      "<p>Please enter a Bible reference.</p>";

    return;
  }

  output.innerHTML =
    "<p>Searching...</p>";

  try {

    let bible = null;

    const translation =
      document.getElementById("translationSelect").value;

    if (translation === "WEB") {

      bible = await getWEB();

    } else if (translation === "ASV") {

      bible = await getASV();

    } else {

      bible = await getKJV();

    }

    const results = findBibleReference(
      bible,
      query
    );

    if (!results.length) {

      output.innerHTML =
        "<p>No matching verses found.</p>";

      return;
    }

    output.innerHTML =
      results.map(function(v) {

        return `
          <div class="verse-card">
            <div class="verse-reference">
              ${escapeHtml(v.reference)}
            </div>

            <div>
              ${escapeHtml(v.text)}
            </div>
          </div>
        `;

      }).join("");

  } catch (error) {

    console.error(error);

    output.innerHTML =
      "<p>Unable to load the Bible right now.</p>";

  }

}


function findBibleReference(bible, query) {

  const results = [];

  if (!bible || !Array.isArray(bible.books)) {
    return results;
  }

  const match =
    query.match(/^(.+?)\s+(\d+)(?::(\d+))?$/);

  if (!match) {
    return results;
  }

  const bookName =
    match[1].trim().toLowerCase();

  const chapterNumber =
    parseInt(match[2]);

  const verseNumber =
    match[3]
      ? parseInt(match[3])
      : null;

  const book =
    bible.books.find(function(book) {

      const names = [
        book.book,
        book.name,
        book.title,
        book.englishName
      ];

      return names.some(function(name) {

        return name &&
          name.toLowerCase() === bookName;

      });

    });

  if (!book) {
    return results;
  }

  const chapter =
    book.chapters &&
    book.chapters.find(function(ch) {

      return Number(
        ch.chapter || ch.number
      ) === chapterNumber;

    });

  if (!chapter) {
    return results;
  }

  const verses =
    chapter.verses || [];

  verses.forEach(function(verse) {

    const number =
      Number(
        verse.number ||
        verse.verse ||
        verse.id
      );

    if (
      verseNumber === null ||
      number === verseNumber
    ) {

      results.push({

        reference:
          book.book +
          " " +
          chapterNumber +
          ":" +
          number,

        text:
          verse.text ||
          verse.content ||
          ""

      });

    }

  });

  return results;
}


